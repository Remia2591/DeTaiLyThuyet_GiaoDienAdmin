@{
    ViewBag.Title = "Thanh toán";
}

<div class="vung">
    <h2 class="tieude">Thanh toán</h2>
    <div id="tomTat"></div>

    <div class="hop">
        <h2>Thông tin giao hàng</h2>
        <label>Họ tên</label>
        <input type="text" id="ten" />
        <label>Số điện thoại</label>
        <input type="text" id="sdt" />
        <label>Địa chỉ</label>
        <input type="text" id="diaChi" />
        <label>Phương thức thanh toán</label>
        <select id="ptt">
            <option>Thanh toán khi nhận hàng</option>
            <option>Chuyển khoản ngân hàng</option>
        </select>
        <button class="nut" onclick="datHang()">Đặt hàng</button>
    </div>
</div>

@section scripts {
    <script>
        var nguoi = nguoiDangNhap();
        if (nguoi) document.getElementById("ten").value = nguoi.ten;

        var g = layGio();
        var t = tinhTien(g);
        var h = '<table class="bang"><tr><th>Sản phẩm</th><th>Số lượng</th><th>Thành tiền</th></tr>';
        for (var i = 0; i < g.length; i++) {
            var s = timSP(g[i].ma);
            h += '<tr><td>' + s.ten + '</td><td>' + g[i].sl + '</td><td>' + dinhDang(s.gia * g[i].sl) + '</td></tr>';
        }
        h += '</table><div class="tomtat" style="max-width:380px;margin-left:auto;">' +
            '<div class="dong"><span>Tạm tính</span><span>' + dinhDang(t.tam) + '</span></div>' +
            '<div class="dong"><span>Phí vận chuyển</span><span>' + (t.phi == 0 ? "Miễn phí" : dinhDang(t.phi)) + '</span></div>' +
            '<div class="dong"><span>Giảm giá</span><span>-' + dinhDang(t.giam) + '</span></div>' +
            '<div class="dong cuoi"><span>Tổng cộng</span><span>' + dinhDang(t.tong) + '</span></div></div>';
        if (g.length == 0) h = '<p>Giỏ hàng trống.</p>';
        document.getElementById("tomTat").innerHTML = h;

        function datHang() {
            var gio = layGio();
            if (gio.length == 0) { alert("Giỏ hàng trống"); return; }
            var ten = document.getElementById("ten").value.trim();
            var sdt = document.getElementById("sdt").value.trim();
            var dc = document.getElementById("diaChi").value.trim();
            var ptt = document.getElementById("ptt").value;
            if (ten == "" || sdt == "" || dc == "") { alert("Vui lòng nhập đủ thông tin"); return; }
            if (!/^0\d{9}$/.test(sdt)) { alert("Số điện thoại phải gồm 10 chữ số, bắt đầu bằng 0"); return; }

            var ds = gio.map(function (x) { return { ma: parseInt(x.ma), sl: x.sl }; });
            guiPost("Order/XuLyDatHang", { ten: ten, sdt: sdt, diaChi: dc, ptt: ptt, gioHangJson: JSON.stringify(ds) }).then(function (r) {
                if (r.success) {
                    localStorage.removeItem("gioHang");
                    localStorage.removeItem("maGiam");
                    alert(r.message + " Mã đơn: " + r.maDonHang);
                    location.href = r.redirectUrl;
                } else alert(r.message);
            });
        }
    </script>
}