@model IEnumerable<DeTaiLyThuyet.Models.DonHang>

<div class="vung">
    <h2 class="tieude">Đơn hàng của tôi</h2>
    @if (Model == null || !Model.Any())
    {
        <p>Bạn chưa có đơn hàng nào.</p>
    }
    else
    {
        foreach (var d in Model)
        {
            <div class="donhang">
                <h3>Đơn @d.MaDonHang <span class="trangthai">@d.TrangThai</span></h3>
                <p>
                    Ngày đặt: @d.NgayDat<br />
                    Người nhận: @d.TenNguoiNhan - @d.SoDienThoai<br />
                    Địa chỉ: @d.DiaChiGiaoHang<br />
                    Thanh toán: @d.PhuongThucThanhToan
                </p>
                <table class="bang">
                    <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
                    @foreach (var c in d.DonHangChiTiets)
                    {
                        <tr>
                            <td>@c.TenSanPham</td>
                            <td>@(((decimal)c.DonGia).ToString("N0")) đ</td>
                            <td>@c.SoLuong</td>
                            <td>@(((decimal)c.ThanhTien).ToString("N0")) đ</td>
                        </tr>
                    }
                </table>
                <div class="tong">Tổng: @(((decimal)d.TongTien).ToString("N0")) đ</div>
            </div>
        }
    }
</div>
